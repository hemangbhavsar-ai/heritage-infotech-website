{
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/config.yml", "destination": "/admin/config.yml" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/((?!admin/).*)", "destination": "/index.html" }
  ]
}